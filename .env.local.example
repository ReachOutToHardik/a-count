# Supabase PostgreSQL connection string — this is the ONLY Supabase value the app needs.
# Supabase Dashboard -> your project -> Connect -> "Transaction pooler" (port 6543).
# The anon / service_role keys are NOT used (the app talks to Postgres directly, server-side only).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# App Security Passphrase (enter this on the login screen)
APP_PASSPHRASE=choose

# Optional: Google Gemini API key for fallback categorization of unmatched entries
GEMINI_API_KEY=
